# ===== Servidor =====
NODE_ENV=development          # development | production (en production se ocultan los stack traces)
PORT=9000
HOST=                         # opcional: interfaz de red donde escucha (ej. 0.0.0.0). Normalmente vacío
ZONA_HORARIA=America/Lima     # define a qué mes pertenece cada movimiento financiero

# ===== Base de datos (OBLIGATORIA) =====
# También se acepta el nombre antiguo MONGO_URL
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/iep

# ===== Autenticación (OBLIGATORIA) =====
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TOKEN_JWT=
TOKEN_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10
DEFAULT_USER_PASSWORD=        # opcional: contraseña inicial si se crea un usuario sin contraseña

# ===== Administrador inicial =====
# Solo se usa al arrancar si NO hay ningún administrador activo. Luego puedes borrar estas variables.
# Roles disponibles (ver src/config/permisos.js): administrador, pastor, secretario, tesorero, lider, lector
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=
ADMIN_CONTRASENA=

# ===== Login =====
LOGIN_MAX_ATTEMPTS=5          # intentos fallidos permitidos por IP+correo
LOGIN_WINDOW_MINUTES=15       # ventana de bloqueo
TRUST_PROXY=                  # 1 si la API está detrás de un proxy (Render, Nginx, Heroku)

# ===== Miembros hábiles para asamblea (valores por defecto; cada asamblea puede cambiarlos) =====
HABILES_MESES=6               # meses hacia atrás que se revisan
HABILES_EDAD_MINIMA=18
HABILES_ASISTENCIA_PCT=50     # % mínimo de domingos con culto a los que asistió
HABILES_SANTA_CENA_PCT=50     # % mínimo de Santas Cenas en las que participó

# ===== Documentación =====
SWAGGER_ENABLED=              # true/false. Vacío = activo excepto en production. UI en /api/docs

# ===== CORS (separados por coma) =====
CORS_ORIGINS=http://localhost:3000
